# Copy this file to .env.local and fill in your values.

# ---------------------------------------------------------------------------
# 1. Database (REQUIRED)
# ---------------------------------------------------------------------------
# Where to get it:
#   Supabase dashboard -> "Connect" button -> "Session pooler" -> URI format
#
#   postgresql://postgres.PROJECTREF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#
# Use the SESSION pooler (port 5432), not the transaction pooler (port 6543).
# The transaction pooler does not support prepared statements, which the `pg`
# driver requires. The session pooler is also IPv4-only, so it works on your
# home network and on Netlify with the same string.
#
# The app uses TLS automatically, so no extra sslmode parameter is needed.
# The tables themselves are created by running supabase/schema.sql in the
# Supabase SQL Editor (see README).
DATABASE_URL=postgresql://postgres.PROJECTREF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# 2. Security (REQUIRED in production)
# ---------------------------------------------------------------------------
# Long random string used to sign the login and admin session cookies.
# Generate one with:  openssl rand -hex 32
# Production logins fail until this is set.
SNAKE_CAFE_SECRET=

# Admin passcode for /admin. Defaults to "admin123" if you leave this blank -
# change it before a real cafe uses the app.
SNAKE_CAFE_ADMIN_PASSCODE=

# ---------------------------------------------------------------------------
# 3. Public site address (optional, recommended before printing table QR codes)
# ---------------------------------------------------------------------------
# Used for canonical URLs, Open Graph metadata and the links encoded in the
# printable table QR cards. On localhost the admin QR page falls back to the
# host you are browsing, so this can stay blank during development.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Member accounts need no extra env vars.
# ---------------------------------------------------------------------------
# Members sign up on /login with a member ID and password. Passwords are
# stored in the members table as salted scrypt hashes.
